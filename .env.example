# =====================================================================
# Modèle des réglages secrets de l'application — AUCUNE VALEUR ICI.
#
# Pendant le démarrage, Claude copie ce fichier en `.env.local`. VOUS n'y
# collez que DEUX jetons (Supabase, puis Vercel), directement dans VS Code ;
# Claude remplit tout le reste lui-même, sans jamais l'afficher.
# Ne collez jamais ces valeurs dans la conversation. `.env.local` ne quitte
# jamais votre ordinateur (il est ignoré par Git).
# =====================================================================

# --- À coller par vous ------------------------------------------------

# Supabase > avatar > Account preferences > Access Tokens > « Generate new token » (sbp_…)
# Permet à Claude de créer le projet, d'appliquer les migrations et de régler l'authentification.
SUPABASE_ACCESS_TOKEN=

# Vercel > avatar > Account Settings > Tokens > « Create »
# Permet à Claude de saisir les variables de l'application en ligne et de la remettre en ligne.
VERCEL_TOKEN=

# --- Rempli par Claude (node outils/supabase.mjs creer-projet) ------------

# Adresse du projet : https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique (sb_publishable_…) : utilisable côté navigateur, protégée par les règles d'accès (RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé SECRÈTE (sb_secret_…) : contourne toutes les règles d'accès. Serveur uniquement.
SUPABASE_SECRET_KEY=
# Mot de passe de la base, généré à la création du projet (les outils n'en ont pas besoin ; à garder).
SUPABASE_DB_PASSWORD=

# Adresse de l'application en local (en ligne, Vercel reçoit l'adresse publique).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
